<Page
    x:Class="NextPlayerWinUI.Views.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextPlayerWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:NextPlayerWinUI.Views"
    xmlns:controls="using:NextPlayerWinUI.Controls"
    xmlns:mycontrols="using:NextPlayerWinUI.Controls"
    mc:Ignorable="d">
    <Grid x:Uid="ShellGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{x:Bind ShellVM.RightPanelWidth, Converter={StaticResource DoubleToGridLengthConverter}, Mode=TwoWay}" MinWidth="{x:Bind ShellVM.RightPanelMinWidth, Mode=OneWay}"/>
        </Grid.ColumnDefinitions>
        <NavigationView
            x:Name="Menu"
            Grid.Row="0"
            Grid.Column="0"
            AutomationProperties.AutomationId="MainNavigation"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            KeyboardAcceleratorPlacementMode="Hidden"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1008"
            MenuItemsSource="{x:Bind ShellVM.PrimaryButtons, Mode=OneWay}"
            ItemInvoked="Menu_ItemInvoked"
            BackRequested="Menu_BackRequested">
            <NavigationView.KeyboardAccelerators>
                <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            </NavigationView.KeyboardAccelerators>
        </NavigationView>
        <mycontrols:PopupNotification 
            Grid.Column="0" Grid.Row="0" 
            x:Name="PopupNotification"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{StaticResource UserAccentBrush}"
            Margin="48,48,0,0"
            Duration="0:0:1"
            ShowAnimationDuration="0:0:0.750"
            HideAnimationDuration="0:0:0.300"
            Height="48"/>
        <UserControl 
            x:Name="BottomPlayerWrapper"
            x:DeferLoadStrategy="Lazy"
            Grid.Row="2"
            Grid.ColumnSpan="2">
            <local:BottomPlayerControl/>
        </UserControl>
        <Grid 
            x:Name="RightPanelWrapper" 
            x:DeferLoadStrategy="Lazy"
                        Grid.Row="0" 
            Grid.Column="1">
            <local:RightPanelControl 
                x:Name="RightPanel" 
                Visibility="{x:Bind ShellVM.IsRightPanelVisible, Mode=OneWay}" />
        </Grid>
        <mycontrols:PaneResizer
            Grid.Column="1"
            Background="Transparent"
            Width="8"
            HorizontalAlignment="Left"
            ManipulationMode="TranslateX"
            ManipulationStarted="{x:Bind ShellVM.GridSplitterManipulationStarted}"
            ManipulationDelta="{x:Bind ShellVM.GridSplitterManipulationDelta}"
            ManipulationCompleted="{x:Bind ShellVM.GridSplitterManipulationCompleted}"
            AutomationProperties.AutomationId="RightPanelResizer"
            />
        <Grid 
            Grid.Row="0" Grid.Column="0"
            x:Name="AdWrapperMobile"
            x:DeferLoadStrategy="Lazy"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="Transparent">
        </Grid>
        <Grid Grid.Row="0" Grid.ColumnSpan="2" 
              x:Name="AdWrapperDesktop" 
              x:DeferLoadStrategy="Lazy"
              Background="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom">
        </Grid>
    </Grid>
</Page>

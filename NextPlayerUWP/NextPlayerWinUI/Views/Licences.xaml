<Page
    x:Class="NextPlayerWinUI.Views.Licences"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextPlayerWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NextPlayerWinUI.Controls"
    xmlns:models="using:NextPlayerWinUI.Models"
    xmlns:triggers="using:WindowsStateTriggers"
    mc:Ignorable="d">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SuppressNavigationTransitionInfo />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:PageHeader
            x:Uid="PageHeaderLicenses"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Content="Licenses" />
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="12,12,12,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Text="This application uses following open source libraries:"
                TextWrapping="WrapWholeWords" />
            <ListView
                x:Name="LicensesListView"
                Grid.Row="1"
                ItemContainerStyle="{StaticResource ListViewItemContainerStyle4}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LicenseModel">
                        <Expander
                            MinWidth="192"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Header="{x:Bind Name}"
                            IsExpanded="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <HyperlinkButton
                                Grid.Row="0"
                                Margin="0,4,0,4"
                                Content="{x:Bind Site}"
                                NavigateUri="{x:Bind Site}" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,8,0,8"
                                Text="{x:Bind License.Type}" />
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,0,0,8"
                                Text="{x:Bind License.Copyright}" />
                            <TextBlock
                                Grid.Row="3"
                                Text="{x:Bind License.Content}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

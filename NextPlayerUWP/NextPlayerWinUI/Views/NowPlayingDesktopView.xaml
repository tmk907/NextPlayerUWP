<Page
    x:Class="NextPlayerWinUI.Views.NowPlayingDesktopView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextPlayerWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Template10.Controls"
    xmlns:mycontrols="using:NextPlayerWinUI.Controls"
    DataContext="{Binding Source={StaticResource Locator}, Path=NowPlayingDesktopVM}"
    mc:Ignorable="d">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SuppressNavigationTransitionInfo />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>
    <Page.Resources>
        <Style
            x:Key="SongDescriptionBigStyle"
            BasedOn="{StaticResource TitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style
            x:Key="SongDescriptionMediumStyle"
            BasedOn="{StaticResource TitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style
            x:Key="SongDescriptionSmallStyle"
            BasedOn="{StaticResource TitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="StarTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="TransparentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource UserAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Name="ShowBGImage">
            <DoubleAnimation
                Storyboard.TargetName="BackgroundImage"
                Storyboard.TargetProperty="(UIElement.Opacity)"
                To="1"
                Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="ShowPrimaryImage">
            <DoubleAnimation
                Storyboard.TargetName="PrimaryImage"
                Storyboard.TargetProperty="(UIElement.Opacity)"
                To="1"
                Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <controls:PageHeader
            x:Uid="PageHeaderNowPlaying"
            Grid.Row="0"
            BackButtonVisibility="Collapsed"
            Content="Now playing"
            Frame="{x:Bind Frame, Mode=OneWay}"
            VisualStateNarrowMinWidth="0"
            VisualStateNormalMinWidth="720">
            <controls:PageHeader.PrimaryCommands>
                <AppBarButton
                    x:Uid="AppBarButtonQueue"
                    Click="{x:Bind ViewModel.GoToNowPlayingPlaylist}"
                    Icon="List"
                    Label="Queue"
                    Visibility="{x:Bind ViewModel.ShowButtons, Mode=OneWay}" />
                <AppBarButton
                    x:Uid="AppBarButtonLyrics"
                    Click="{x:Bind ViewModel.GoToLyrics}"
                    Icon="Font"
                    Label="Lyrics"
                    Visibility="{x:Bind ViewModel.ShowButtons, Mode=OneWay}" />
            </controls:PageHeader.PrimaryCommands>
        </controls:PageHeader>
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="13*" />
                <RowDefinition Height="8*" />
            </Grid.RowDefinitions>
            <Image
                x:Name="BackgroundImage"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:DeferLoadStrategy="Lazy"
                Opacity="0"
                Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind ViewModel.QueueVM.CoverUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
            <!--<imagecontrol:CrossfadingImage x:Name="BackgroundImage"
                                           x:DeferLoadStrategy="Lazy"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           Opacity="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FadeInDuration="0:0:0.3"
                                           FadeOutDuration="0:0:0.3"
                                           ImageUri="{x:Bind ViewModel.QueueVM.CoverUri, Mode=OneWay}"
                                           Stretch="UniformToFill" />-->
            <!--<mycontrols:BackDrop
                x:Name="BackDropControl"
                Grid.Row="0"
                Grid.RowSpan="2"
                BlurAmount="{Binding ElementName=BlurAmountSlider, Path=Value, Mode=TwoWay}"
                TintAlpha="{Binding ElementName=TintAlphaSlider, Path=Value, Mode=TwoWay}"
                SaturationIntensity="{Binding ElementName=SaturationIntensitySlider, Path=Value, Mode=TwoWay}"
                TintColor="Gray"/>-->
            <!--<mycontrols:BackDrop
                x:Name="BackDropControl"
                x:DeferLoadStrategy="Lazy"
                Grid.Row="0"
                Grid.RowSpan="2"
                BlurAmount="85"
                TintAlpha="100"
                SaturationIntensity="1.1"
                TintColor="{x:Bind ViewModel.QueueVM.AlbumArtColor, Mode=OneWay}"/>-->
            <Image
                x:Name="PrimaryImage"
                Grid.Row="0"
                Margin="8,4,8,0"
                Opacity="0"
                SizeChanged="PrimaryImage_SizeChanged"
                Stretch="Uniform" />
            <!--<imagecontrol:CrossfadingImage x:Name="PrimaryImage"
                                           Grid.Row="0"
                                           Opacity="0"
                                           SizeChanged="PrimaryImage_SizeChanged"
                                           Margin="8,4,8,0"
                                           FadeInDuration="0:0:0.3"
                                           FadeOutDuration="0:0:0.3"
                                           Stretch="Uniform" />-->
            <Grid
                x:Name="SongDescriptionGrid"
                Grid.Row="1"
                Margin="8,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--<StackPanel
                    Grid.RowSpan="4">
                    <Slider x:Name="BlurAmountSlider"
                        Header="Blur Amount"
                        Value="85"/>
                    <Slider x:Name="TintAlphaSlider"
                        Maximum="255"
                        Value="100"
                        Header="Tint Alpha" />
                    <Slider x:Name="SaturationIntensitySlider"
                        Maximum="2"
                        StepFrequency=".05"
                        Value="1.1"
                        Header="Saturation Intensity" />
                </StackPanel>-->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,32,0"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Click="{x:Bind ViewModel.RateSong}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="0" />
                    <Button
                        Grid.Column="1"
                        Click="{x:Bind ViewModel.RateSong}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="1">
                        <Button.Content>
                            <TextBlock Style="{StaticResource StarTextBlockStyle}" Text="{Binding QueueVM.CurrentSong.Rating, Converter={StaticResource IntToRatingStarConverter}, ConverterParameter=1}" />
                        </Button.Content>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Click="{x:Bind ViewModel.RateSong}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="2">
                        <Button.Content>
                            <TextBlock Style="{StaticResource StarTextBlockStyle}" Text="{Binding QueueVM.CurrentSong.Rating, Converter={StaticResource IntToRatingStarConverter}, ConverterParameter=2}" />
                        </Button.Content>
                    </Button>
                    <Button
                        Grid.Column="3"
                        Click="{x:Bind ViewModel.RateSong}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="3">
                        <Button.Content>
                            <TextBlock Style="{StaticResource StarTextBlockStyle}" Text="{Binding QueueVM.CurrentSong.Rating, Converter={StaticResource IntToRatingStarConverter}, ConverterParameter=3}" />
                        </Button.Content>
                    </Button>
                    <Button
                        Grid.Column="4"
                        Click="{x:Bind ViewModel.RateSong}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="4">
                        <Button.Content>
                            <TextBlock Style="{StaticResource StarTextBlockStyle}" Text="{Binding QueueVM.CurrentSong.Rating, Converter={StaticResource IntToRatingStarConverter}, ConverterParameter=4}" />
                        </Button.Content>
                    </Button>
                    <Button
                        Grid.Column="5"
                        Click="{x:Bind ViewModel.RateSong}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Tag="5">
                        <Button.Content>
                            <TextBlock Style="{StaticResource StarTextBlockStyle}" Text="{Binding QueueVM.CurrentSong.Rating, Converter={StaticResource IntToRatingStarConverter}, ConverterParameter=5}" />
                        </Button.Content>
                    </Button>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="4,0,4,4"
                    Style="{StaticResource SongDescriptionBigStyle}"
                    Text="{x:Bind ViewModel.QueueVM.CurrentSong.Title, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="4,0,4,4"
                    Style="{StaticResource SongDescriptionMediumStyle}"
                    Text="{x:Bind ViewModel.QueueVM.CurrentSong.Artist, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="3"
                    Margin="4,0,4,0"
                    Style="{StaticResource SongDescriptionSmallStyle}"
                    Text="{x:Bind ViewModel.QueueVM.CurrentSong.Album, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>

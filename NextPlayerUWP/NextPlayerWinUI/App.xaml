            <DataTemplate x:Key="ZoomedOutItemsTemplate">
                <Border
                    Width="{Binding Group.Header, Converter={StaticResource ZoomedOutItemWidthConverter}, ConverterParameter=desktop}"
                    Height="84"
                    Background="Transparent"
                    BorderBrush="{StaticResource SystemControlBackgroundAccentBrush}"
                    BorderThickness="0,0,0,1">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="32"
                        FontWeight="Normal"
                        Foreground="{StaticResource SystemControlBackgroundAccentBrush}"
                        Text="{Binding Group.Key}" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ZoomedOutItemsTemplateMobile">
                <Border
                    Width="{Binding Group.Header, Converter={StaticResource ZoomedOutItemWidthConverter}, ConverterParameter=mobile}"
                    Height="48"
                    Margin="0,0,0,4"
                    Background="Transparent"
                    BorderBrush="{StaticResource SystemControlBackgroundAccentBrush}"
                    BorderThickness="0,0,0,1">
                    <TextBlock
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="26"
                        FontWeight="Normal"
                        Foreground="{StaticResource SystemControlBackgroundAccentBrush}"
                        Text="{Binding Group.Key}" />
                </Border>
            </DataTemplate>


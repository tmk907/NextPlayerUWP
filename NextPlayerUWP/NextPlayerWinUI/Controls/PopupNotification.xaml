<UserControl
    x:Class="NextPlayerWinUI.Controls.PopupNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextPlayerWinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootControl"
    d:DesignHeight="48"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <Grid>
        <Grid
            x:Name="NotificationPanel"
            MaxWidth="200"
            Margin="0,4,-100,4"
            HorizontalAlignment="Right"
            Background="{Binding Background, ElementName=RootControl}"
            Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition x:Name="BottomRow" Height="0" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="NotificationText"
                Grid.Row="0"
                Margin="4,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="White"
                Text="{x:Bind Text, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="NotificationTextBottom"
                Grid.Row="1"
                Margin="4,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="White"
                Text="{x:Bind TextBottom, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</UserControl>
